{
  "name": "boublej-blog",
  "version": "1.0.0",
  "private": true,
  "description": "BoubleJ's tech blog built with Astro",
  "author": "jaejungbyun",
  "keywords": [
    "astro"
  ],
  "scripts": {
    "develop": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "serve": "astro preview",
    "clean": "rm -rf dist .astro",
    "deploy": "astro build && gh-pages -d dist -b master",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/react": "^6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@vanilla-extract/css": "^1.18.0",
    "astro": "^7.2.6",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-string": "^3.0.1",
    "prism-themes": "^1.9.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "reading-time": "^1.5.0",
    "rehype-external-links": "^3.0.0",
    "remark-smartypants": "^3.0.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.3.11",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "gh-pages": "^6.3.0",
    "lefthook": "^2.1.0",
    "typescript": "^5.9.3"
  }
}
