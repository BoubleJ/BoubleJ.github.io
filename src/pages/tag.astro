---
// src/pages/tag.astro — 기존 /tag 페이지 (Task 10)
import TagPageClient from "@/components/Tag/TagPageClient";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
import { getSortedPosts, toPostSummaries } from "@/lib/posts";

const posts = await toPostSummaries(await getSortedPosts());
---

<Layout title={`${SITE.title} - Tags`} description={SITE.description} url={SITE.siteUrl}>
  <TagPageClient client:load posts={posts} />
</Layout>
