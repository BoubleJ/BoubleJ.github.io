---
import PostPageClient from "@/components/PostList/PostPageClient";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
import { getSortedPosts, toPostSummaries } from "@/lib/posts";

const posts = await toPostSummaries(await getSortedPosts());
---

<Layout title={SITE.title} description={SITE.description} url={SITE.siteUrl}>
  <PostPageClient client:load posts={posts} />
</Layout>
