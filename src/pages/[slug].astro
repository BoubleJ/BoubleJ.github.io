---
// src/pages/[slug].astro — 기존 src/templates/post_template.tsx 재현 (MDX 버전)
import type { MarkdownHeading } from "astro";
import CheckIcon from "@/assets/icons/check.svg";
import CopyIcon from "@/assets/icons/copy.svg";
import CommentWidget from "@/components/Post/CommentWidget.astro";
import PostHead from "@/components/Post/PostHead";
import TableOfContents from "@/components/Post/TableOfContents";
import Layout from "@/layouts/Layout.astro";
import { formatDate, getReadingTimeText, getSortedPosts } from "@/lib/posts";
import {
  markdownRenderer,
  postBody,
  postBodyContent,
  postBodyToc,
} from "@/pages-styles/post_template.css";
// 본문 요소 스타일 + 복사 버튼 + 다크모드 Prism 오버라이드 (Gatsby에서는 PostContent.tsx가 import — 전환 시 유실됐던 것)
import "@/styles/markdown.css";
import { getImage } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";

interface Props {
  entry: CollectionEntry<"posts">;
}

export async function getStaticPaths() {
  return (await getSortedPosts()).map((entry: CollectionEntry<"posts">) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { title, summary, categories, thumbnail } = entry.data;
const date = formatDate(entry.data.date);
const readingTimeText = getReadingTimeText(entry);
const { Content, headings } = await render(entry);
// 헤더 배경은 전폭이라 1200 폭 webp 하나면 됩니다.
const headImage = await getImage({ src: thumbnail, format: "webp", width: 1200 });
// OG 는 크롤러 호환을 위해 원본 포맷(png/jpg)을 그대로 넘깁니다.
const ogImage = thumbnail.src;
---
<Layout
  title={title}
  description={summary}
  url={decodeURI(new URL(Astro.url.pathname, Astro.site).href)}
  image={ogImage}
  type="article"
  datePublished={entry.data.date}
>
  <PostHead client:load title={title} date={date} categories={categories} thumbnail={headImage.src} readingTimeText={readingTimeText} />
  <div class={postBody}>
    <div class={postBodyContent}>
      <div class={`${markdownRenderer} markdown-content`}>
        <Content />
      </div>
    </div>
    <aside class={postBodyToc}>
      <TableOfContents client:load headings={headings.filter((h: MarkdownHeading) => h.depth <= 3)} />
    </aside>
  </div>
  <CommentWidget />
  <div id="reading-progress" aria-hidden="true"></div>
  {/* 복사 버튼은 code-copy.ts가 런타임에 주입하므로 아이콘을 빌드 타임에 template으로 심어두고 복제해 쓴다 */}
  <template id="icon-copy"><CopyIcon /></template>
  <template id="icon-check"><CheckIcon /></template>
  <script src="../scripts/code-copy.ts"></script>
  <script src="../scripts/reading-progress.ts"></script>
  <script src="../scripts/anchor-history.ts"></script>
  <script src="../scripts/mermaid.ts"></script>
</Layout>
