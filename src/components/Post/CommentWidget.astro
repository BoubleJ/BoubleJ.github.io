---
import { utterancesWrapper } from "@/components/Post/CommentWidget.css";
---

<div class={utterancesWrapper} id="comment-widget"></div>
<script is:inline>
(() => {
  const dark =
    localStorage.getItem("theme") === "dark" ||
    (!localStorage.getItem("theme") &&
      matchMedia("(prefers-color-scheme: dark)").matches);

  const container = document.getElementById("comment-widget");
  const s = document.createElement("script");
  s.src = "https://utteranc.es/client.js";
  s.async = true;
  s.crossOrigin = "anonymous";
  s.setAttribute("repo", "BoubleJ/BoubleJ.github.io");
  s.setAttribute("issue-term", "pathname");
  s.setAttribute("label", "Comment");
  s.setAttribute("theme", dark ? "github-dark" : "github-light");
  container?.appendChild(s);

  window.addEventListener("themechange", (e) => {
    const iframe = document.querySelector("iframe.utterances-frame");
    if (!iframe?.contentWindow) return;
    iframe.contentWindow.postMessage(
      { type: "set-theme", theme: `github-${e.detail.theme}` },
      "https://utteranc.es",
    );
  });
})();
</script>
